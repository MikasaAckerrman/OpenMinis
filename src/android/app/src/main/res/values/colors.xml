<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="seed">#6750A4</color>
    <!--
      T-android-shortcut-icons-blank: foreground glyph color for the
      app-icon shortcut adaptive icons. Dark glyph on the light
      @color/ic_launcher_background (#EFF2F6); the values-night variant
      flips to a light glyph on the dark night background (#2C3034) so
      the shortcuts stay legible in both themes. Fixed colors (not theme
      attrs) because the launcher process renders shortcut icons and
      can't resolve the app's ?attr tints.
    -->
    <color name="shortcut_icon_fg">#1F2933</color>
    <!--
      Soft-dark rebuild: the dark window/splash background must match the
      Compose ChatColors dark `background` (#121212). Referenced from
      values-night/themes.xml so the OS-painted first frame (cold start,
      Activity recreation, NavHost cross-fades) lands on the same soft
      dark as the app content instead of pure black flashing through.
    -->
    <color name="minis_dark_window_bg">#121212</color>
</resources>
