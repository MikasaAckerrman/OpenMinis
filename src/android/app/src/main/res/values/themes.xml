<?xml version="1.0" encoding="utf-8"?>
<!-- T153 — light-mode window theme. Pair with values-night/themes.xml
     so the OS-painted first frame (cold start / Activity recreation)
     matches the Compose theme on each side. Without an explicit
     windowBackground the platform falls back to the system default,
     which on AOSP/Pixel light mode is white but on some OEM light
     skins is a light grey — visible as a 1-frame jog during nav
     transitions. -->
<resources>
    <style name="Theme.Minis" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorBackground">@android:color/white</item>
    </style>

    <!-- Windowless host for the translation entry points (PROCESS_TEXT menu,
         quick-settings tile). These activities have no layout of their own —
         they only show a dialog — so the window itself must be invisible,
         otherwise a white card flashes over the app the user was reading.
         Theme.NoDisplay cannot be used: it forbids showing any window at all,
         and AlertDialog is a window. -->
    <style name="Theme.Minis.Translucent" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>

